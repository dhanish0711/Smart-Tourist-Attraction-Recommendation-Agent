{
  "name": "Smart Tourist Agent - Enterprise Autonomous Weather Monitoring & Replan",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "78e0e4c3-28f2-4a0a-b6ee-d027d14e0590",
      "name": "Every Morning 7:00 AM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        208,
        -224
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "dest-var",
              "name": "destination",
              "value": "={{ $json.body?.destination || $json.destination || 'Jaipur' }}",
              "type": "string"
            },
            {
              "id": "email-var",
              "name": "traveler_email",
              "value": "={{ $json.body?.email || $json.email || 'dhanishladwani@gmail.com' }}",
              "type": "string"
            },
            {
              "id": "tripid-var",
              "name": "trip_id",
              "value": "={{ $json.body?.trip_id || $json.trip_id || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "d2615bb5-ef67-4e75-9f9a-321ecd381ab7",
      "name": "Initialize Trip Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        -128
      ]
    },
    {
      "parameters": {
        "url": "=https://geocoding-api.open-meteo.com/v1/search?name={{ encodeURIComponent($json.destination) }}&count=1&language=en&format=json",
        "options": {}
      },
      "id": "5871c691-f4c8-4bef-b5e1-6bd827d72c7c",
      "name": "Geocode Destination Coordinates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        -128
      ]
    },
    {
      "parameters": {
        "url": "=https://api.open-meteo.com/v1/forecast?latitude={{ $json.results ? $json.results[0].latitude : 26.9124 }}&longitude={{ $json.results ? $json.results[0].longitude : 75.7873 }}&daily=weathercode,precipitation_probability_max,precipitation_sum,temperature_2m_max,temperature_2m_min&timezone=auto&forecast_days=1",
        "options": {}
      },
      "id": "7c20fab8-f1a6-42ff-a6cf-23cd8914816a",
      "name": "Fetch Live Weather (Open-Meteo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        -128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "rain-condition",
              "leftValue": "={{ $json.daily.precipitation_probability_max[0] }}",
              "rightValue": 50,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "689e58a2-0213-47a7-99d7-6022c33d55f0",
      "name": "Rain Alert Detected? (>=50%)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        -128
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://smart-tourist-attraction-recommendation.onrender.com/api/replan",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"disruption_type\": \"weather_rain\",\n  \"rain_probability\": {{ $('Fetch Live Weather (Open-Meteo)').item.json.daily.precipitation_probability_max[0] }},\n  \"trip_id\": \"{{ $('Initialize Trip Context').item.json.trip_id }}\",\n  \"destination\": \"{{ $('Initialize Trip Context').item.json.destination }}\",\n  \"traveler_email\": \"{{ $('Initialize Trip Context').item.json.traveler_email }}\"\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "a886885e-35ab-4f38-b100-83fdf980b941",
      "name": "Trigger Agent Replan Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1456,
        -224
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "sendTo": "={{ $('Initialize Trip Context').item.json.traveler_email }}",
        "subject": "=🌧️ Weather Alert: Autonomous Trip Schedule Update for {{ $('Initialize Trip Context').item.json.destination }}",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #e2e8f0; border-radius: 12px; background-color: #ffffff;\">\n  <div style=\"background: linear-gradient(135deg, #1e3a8a, #3b82f6); padding: 20px; border-radius: 8px; text-align: center; color: #ffffff;\">\n    <h2 style=\"margin: 0; font-size: 22px;\">🌧️ Weather Disruption Detected</h2>\n    <p style=\"margin: 8px 0 0 0; opacity: 0.9;\">Autonomous Itinerary Adaptation for <strong>{{ $('Initialize Trip Context').item.json.destination }}</strong></p>\n  </div>\n  <div style=\"padding: 20px 0;\">\n    <p>Good morning traveler,</p>\n    <p>Live meteorological monitoring has identified a <strong>{{ $('Fetch Live Weather (Open-Meteo)').item.json.daily.precipitation_probability_max[0] }}% chance of precipitation</strong> today.</p>\n    <div style=\"background: #eff6ff; border-left: 4px solid #3b82f6; padding: 12px 16px; border-radius: 4px; margin: 16px 0;\">\n      <h4 style=\"margin: 0 0 6px 0; color: #1e3a8a;\">🛡️ Autonomous Agent Self-Correction:</h4>\n      <ul style=\"margin: 0; padding-left: 20px; color: #1e293b;\">\n        <li>Outdoor sightseeing moved or swapped for curated indoor museums & cultural galleries.</li>\n        <li>Transit routes and traveling windows re-optimized.</li>\n      </ul>\n    </div>\n    <h4 style=\"color: #0f172a;\">📥 Download Refreshed Travel Documents:</h4>\n    <p>\n      <a href=\"https://smart-tourist-attraction-recommendation.onrender.com/api/download/ics/{{ $json.trip_id || $('Initialize Trip Context').item.json.trip_id }}\" style=\"display: inline-block; background: #0284c7; color: #ffffff; padding: 10px 18px; border-radius: 6px; text-decoration: none; margin-right: 10px; font-size: 14px; font-weight: bold;\">📅 Sync Calendar (.ics)</a>\n      <a href=\"https://smart-tourist-attraction-recommendation.onrender.com/api/download/pdf/{{ $json.trip_id || $('Initialize Trip Context').item.json.trip_id }}\" style=\"display: inline-block; background: #475569; color: #ffffff; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: bold;\">📄 Printable PDF Dossier</a>\n    </p>\n  </div>\n  <div style=\"border-top: 1px solid #e2e8f0; padding-top: 14px; font-size: 12px; color: #64748b; text-align: center;\">\n    Autonomous Trip Monitor • Smart Tourist Attraction Recommendation Agent\n  </div>\n</div>",
        "options": {}
      },
      "id": "5796c22d-117c-43c5-98bf-3d45722b6869",
      "name": "Send Gmail Rain Alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1712,
        -224
      ],
      "webhookId": "ec1055a5-1a06-44bc-8558-1c21be67b83d",
      "credentials": {
        "gmailOAuth2": {
          "id": "EWjxiXNPOkBZUJXJ",
          "name": "Gmail account"
        }
      }
