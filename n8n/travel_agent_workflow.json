    {
      "parameters": {
        "sendTo": "={{ $('Initialize Trip Context').item.json.traveler_email }}",
        "subject": "=☀️ Clear Skies Confirmed for {{ $('Initialize Trip Context').item.json.destination }}",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #e2e8f0; border-radius: 12px; background-color: #ffffff;\">\n  <div style=\"background: linear-gradient(135deg, #059669, #10b981); padding: 20px; border-radius: 8px; text-align: center; color: #ffffff;\">\n    <h2 style=\"margin: 0; font-size: 22px;\">☀️ Good Morning Traveler!</h2>\n    <p style=\"margin: 8px 0 0 0; opacity: 0.9;\">Clear weather confirmed for <strong>{{ $('Initialize Trip Context').item.json.destination }}</strong></p>\n  </div>\n  <div style=\"padding: 20px 0; color: #334155;\">\n    <p>Good morning,</p>\n    <p>Great news! Today's forecast indicates ideal conditions for outdoor exploration (Expected High: <strong>{{ $('Fetch Live Weather (Open-Meteo)').item.json.daily.temperature_2m_max[0] }}°C</strong>, Rain Probability: <strong>{{ $('Fetch Live Weather (Open-Meteo)').item.json.daily.precipitation_probability_max[0] }}%</strong>).</p>\n    <p>All scheduled outdoor sights and attractions are proceeding exactly according to your planned itinerary.</p>\n    <h4 style=\"color: #0f172a; margin-top: 16px;\">📥 Your Travel Documents & Itinerary:</h4>\n    <p>\n      <a href=\"https://smart-tourist-attraction-recommendation.onrender.com/api/download/ics/{{ $json.trip_id || $('Initialize Trip Context').item.json.trip_id || 'trip_live' }}\" style=\"display: inline-block; background: #0284c7; color: #ffffff; padding: 10px 18px; border-radius: 6px; text-decoration: none; margin-right: 10px; font-size: 14px; font-weight: bold;\">📅 Sync Calendar (.ics)</a>\n      <a href=\"https://smart-tourist-attraction-recommendation.onrender.com/api/download/pdf/{{ $json.trip_id || $('Initialize Trip Context').item.json.trip_id || 'trip_live' }}\" style=\"display: inline-block; background: #475569; color: #ffffff; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: bold;\">📄 Printable PDF Dossier</a>\n    </p>\n    <p style=\"margin-top: 14px;\">Enjoy your adventure today!</p>\n  </div>\n  <div style=\"border-top: 1px solid #e2e8f0; padding-top: 14px; font-size: 12px; color: #64748b; text-align: center;\">\n    Smart Tourist Attraction Recommendation Agent\n  </div>\n</div>",
        "options": {}
      },
      "id": "a3c848e0-f504-4cee-8d40-c3e35ff852de",
      "name": "Send Gmail Sunny Day Confirmation",
