{
  "name": "Smart Tourist Agent - Enterprise Autonomous Weather Monitoring & Replan",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger-node",
      "name": "Every Morning 7:00 AM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        160,
        240
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trip-monitor",
        "options": {}
      },
      "id": "webhook-trigger-node",
      "name": "On-Demand Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        160,
        440
      ],
      "webhookId": "trip-monitor-webhook"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "dest-var",
              "name": "destination",
              "value": "={{ $json.body?.destination || $json.destination || 'Jaipur' }}",
              "type": "string"
            },
            {
              "id": "email-var",
              "name": "traveler_email",
              "value": "={{ $json.body?.email || $json.email || 'traveler@example.com' }}",
              "type": "string"
            },
            {
              "id": "tripid-var",
              "name": "trip_id",
              "value": "={{ $json.body?.trip_id || $json.trip_id || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-context-node",
      "name": "Initialize Trip Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        420,
        340
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://geocoding-api.open-meteo.com/v1/search?name={{ encodeURIComponent($json.destination) }}&count=1&language=en&format=json",
        "options": {}
      },
      "id": "geocoding-node",
      "name": "Geocode Destination Coordinates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        340
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.open-meteo.com/v1/forecast?latitude={{ $json.results ? $json.results[0].latitude : 26.9124 }}&longitude={{ $json.results ? $json.results[0].longitude : 75.7873 }}&daily=weathercode,precipitation_probability_max,precipitation_sum,temperature_2m_max,temperature_2m_min&timezone=auto&forecast_days=1",
        "options": {}
      },
      "id": "weather-node",
      "name": "Fetch Live Weather (Open-Meteo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        340
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "rain-condition",
              "leftValue": "={{ $json.daily.precipitation_probability_max[0] }}",
              "rightValue": 50,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-node",
      "name": "Rain Alert Detected? (>=50%)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1140,
        340
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://compare-stole-juicy.ngrok-free.dev/api/replan",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"disruption_type\": \"weather_rain\",\n  \"rain_probability\": {{ $('Fetch Live Weather (Open-Meteo)').item.json.daily.precipitation_probability_max[0] }}\n}",
        "options": {}
      },
      "id": "replan-webhook-node",
      "name": "Trigger Agent Replan Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        240
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Initialize Trip Context').item.json.traveler_email }}",
        "subject": "=🌧️ Weather Alert: Autonomous Trip Schedule Update for {{ $('Initialize Trip Context').item.json.destination }}",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #e2e8f0; border-radius: 12px; background-color: #ffffff;\">\n  <div style=\"background: linear-gradient(135deg, #1e3a8a, #3b82f6); padding: 20px; border-radius: 8px; text-align: center; color: #ffffff;\">\n    <h2 style=\"margin: 0; font-size: 22px;\">🌧️ Weather Disruption Detected</h2>\n    <p style=\"margin: 8px 0 0 0; opacity: 0.9;\">Autonomous Itinerary Adaptation for <strong>{{ $('Initialize Trip Context').item.json.destination }}</strong></p>\n  </div>\n  <div style=\"padding: 20px 0;\">\n    <p>Good morning traveler,</p>\n    <p>Live meteorological monitoring has identified a <strong>{{ $('Fetch Live Weather (Open-Meteo)').item.json.daily.precipitation_probability_max[0] }}% chance of precipitation</strong> today.</p>\n    <div style=\"background: #eff6ff; border-left: 4px solid #3b82f6; padding: 12px 16px; border-radius: 4px; margin: 16px 0;\">\n      <h4 style=\"margin: 0 0 6px 0; color: #1e3a8a;\">🛡️ Autonomous Agent Self-Correction:</h4>\n      <ul style=\"margin: 0; padding-left: 20px; color: #1e293b;\">\n        <li>Outdoor sightseeing moved or swapped for curated indoor museums & cultural galleries.</li>\n        <li>Transit routes and traveling windows re-optimized.</li>\n      </ul>\n    </div>\n    <h4 style=\"color: #0f172a;\">📥 Download Refreshed Travel Documents:</h4>\n    <p>\n      <a href=\"https://compare-stole-juicy.ngrok-free.dev/api/download/ics/{{ $json.trip_id }}\" style=\"display: inline-block; background: #0284c7; color: #ffffff; padding: 10px 18px; border-radius: 6px; text-decoration: none; margin-right: 10px; font-size: 14px; font-weight: bold;\">📅 Sync Calendar (.ics)</a>\n      <a href=\"https://compare-stole-juicy.ngrok-free.dev/api/download/pdf/{{ $json.trip_id }}\" style=\"display: inline-block; background: #475569; color: #ffffff; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: bold;\">📄 Printable PDF Dossier</a>\n    </p>\n  </div>\n  <div style=\"border-top: 1px solid #e2e8f0; padding-top: 14px; font-size: 12px; color: #64748b; text-align: center;\">\n    Autonomous Trip Monitor • Smart Tourist Attraction Recommendation Agent\n  </div>\n</div>",
        "options": {}
      },
      "id": "gmail-alert-node",
      "name": "Send Gmail Rain Alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1660,
        240
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Initialize Trip Context').item.json.traveler_email }}",
        "subject": "=☀️ Clear Skies Confirmed for {{ $('Initialize Trip Context').item.json.destination }}",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #e2e8f0; border-radius: 12px; background-color: #ffffff;\">\n  <div style=\"background: linear-gradient(135deg, #059669, #10b981); padding: 20px; border-radius: 8px; text-align: center; color: #ffffff;\">\n    <h2 style=\"margin: 0; font-size: 22px;\">☀️ Good Morning Traveler!</h2>\n    <p style=\"margin: 8px 0 0 0; opacity: 0.9;\">Clear weather confirmed for <strong>{{ $('Initialize Trip Context').item.json.destination }}</strong></p>\n  </div>\n  <div style=\"padding: 20px 0; color: #334155;\">\n    <p>Good morning,</p>\n    <p>Great news! Today's forecast indicates ideal conditions for outdoor exploration (Expected High: <strong>{{ $('Fetch Live Weather (Open-Meteo)').item.json.daily.temperature_2m_max[0] }}°C</strong>, Rain Probability: <strong>{{ $('Fetch Live Weather (Open-Meteo)').item.json.daily.precipitation_probability_max[0] }}%</strong>).</p>\n    <p>All scheduled outdoor sights and attractions are proceeding exactly according to your planned itinerary.</p>\n    <p>Enjoy your adventure today!</p>\n  </div>\n  <div style=\"border-top: 1px solid #e2e8f0; padding-top: 14px; font-size: 12px; color: #64748b; text-align: center;\">\n    Smart Tourist Attraction Recommendation Agent\n  </div>\n</div>",
        "options": {}
      },
      "id": "gmail-sunny-node",
      "name": "Send Gmail Sunny Day Confirmation",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1400,
        440
      ]
    }
  ],
  "connections": {
    "Every Morning 7:00 AM Trigger": {
      "main": [
        [
          {
            "node": "Initialize Trip Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "On-Demand Webhook Trigger": {
      "main": [
        [
          {
            "node": "Initialize Trip Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Initialize Trip Context": {
      "main": [
        [
          {
            "node": "Geocode Destination Coordinates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Geocode Destination Coordinates": {
      "main": [
        [
          {
            "node": "Fetch Live Weather (Open-Meteo)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Live Weather (Open-Meteo)": {
      "main": [
        [
          {
            "node": "Rain Alert Detected? (>=50%)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rain Alert Detected? (>=50%)": {
      "main": [
        [
          {
            "node": "Trigger Agent Replan Webhook",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Gmail Sunny Day Confirmation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Agent Replan Webhook": {
      "main": [
        [
          {
            "node": "Send Gmail Rain Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}