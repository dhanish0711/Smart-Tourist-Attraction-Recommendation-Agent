# Smart Tourist Attraction Recommendation Agent - Environment Configuration

# Free LLM APIs (Provide at least one, or leave blank to use the built-in deterministic engine)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Tavily AI Web Search (Free Tier: 1,000 searches/month from https://tavily.com/)
TAVILY_API_KEY=

# Langflow (Optional, if running Langflow visual designer locally on port 7860)
LANGFLOW_API_URL=http://127.0.0.1:7860/api/v1/run
LANGFLOW_FLOW_ID=

# n8n Integration (Optional public tunnel URL for cloud n8n webhook connection)
N8N_TUNNEL_URL=https://your-tunnel.ngrok-free.dev
